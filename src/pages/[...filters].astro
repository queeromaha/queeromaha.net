---
import { Icon } from 'astro-icon/components'
import FilterBar from '#components/FilterBar.astro'
import ItemCard from '#components/ItemCard.astro'
import LD from '#components/LD.astro'
import site from '#data/site.json'
import Base from '#layouts/Base.astro'
import { computeItemSlugs } from '#utils/itemSlug.ts'
import {
    categoryMap,
    getFilterStaticPaths,
    resolveFilters,
} from '#utils/resolveFilters.ts'

export async function getStaticPaths() {
    const paths = await getFilterStaticPaths()
    return paths.map((filters) => ({ params: { filters } }))
}

const { filters = '' } = Astro.params
const {
    entries,
    initialCategories,
    matchesInitial,
    activeCategoryHasFilters,
    initialItemSlug,
    pageTitle,
    pageDescription,
} = await resolveFilters(filters)

// Each route ships only its own category's cards (the root renders the
// default category), so a category switch is a plain navigation and the
// page stays small and correct without JS.
const visibleEntries = entries.filter((entry) => matchesInitial(entry.id))

// Ties the per-item Organization JSON-LD blocks (emitted by ItemCard) together
// as "this page lists these entities" — crawlers otherwise see a pile of
// disconnected Organization blocks with no listing structure.
const visibleItemListElements = visibleEntries.flatMap((entry) => {
    const publicItems = (entry.data.items ?? []).filter(
        (i) => i.public !== false,
    )
    const itemSlugs = computeItemSlugs(publicItems)
    return publicItems.map((item, i) => ({
        name: item.name,
        url: new URL(`/${entry.id}/${itemSlugs[i].canonical}`, site.url).href,
    }))
})
---

<Base
  title={pageTitle}
  description={pageDescription}
  initialCategories={initialCategories}
  initialItemSlug={initialItemSlug}
>
  <LD
    data={{
      "@context": "https://schema.org",
      "@type": "ItemList",
      itemListElement: visibleItemListElements.map((el, i) => ({
        "@type": "ListItem",
        position: i + 1,
        url: el.url,
        name: el.name,
      })),
    }}
  />
  {activeCategoryHasFilters && <FilterBar />}
  {
    visibleEntries.map((entry) => {
      const publicItems = (entry.data.items ?? []).filter(
        (i) => i.public !== false,
      );
      if (publicItems.length === 0) return null;
      const itemSlugs = computeItemSlugs(publicItems);
      return (
        <section
          id={`section-${entry.id}`}
          aria-label={categoryMap[entry.id]?.label ?? entry.id}
        >
          <h2
            class="section-header"
            data-category-heading={entry.id}
          >
            <Icon
              class="section-icon"
              name={categoryMap[entry.id]?.icon}
              width="1.25em"
              height="1.25em"
              aria-hidden="true"
            />
            {categoryMap[entry.id]?.label ?? entry.id}
          </h2>
          {publicItems.map((item, i) => (
            <ItemCard
              item={item}
              category={entry.id}
              slug={itemSlugs[i].canonical}
            />
          ))}
        </section>
      );
    })
  }
</Base>

<style>
  .section-header {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    gap: 0.4rem;
    width: 100%;
    margin: 0.75rem 0 0.5rem;
    color: #6d28d9;
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    @media (prefers-color-scheme: dark) {
      color: var(--dm-glow);
    }
  }

  .section-icon {
    font-size: 1.2em;
  }
</style>
