---
import karlaNormalUrl from '@fontsource-variable/karla/files/karla-latin-wght-normal.woff2?url'
import spaceGroteskNormalUrl from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url'
import LD from './LD.astro'
import PostHog from './posthog.astro'

interface Props {
    title: string
    description?: string
    canonicalUrl: string
    refresh?: { seconds: number; url: string }
    /** Link-preview image (1200x630 PNG), site-relative or absolute */
    image?: string
    imageAlt?: string
}

const {
    title,
    description,
    canonicalUrl,
    refresh,
    image = '/og-image.png',
    imageAlt = 'Queer Omaha: community-maintained directory of queer groups, spaces, and resources in Omaha, Nebraska.',
} = Astro.props
const imageUrl = new URL(image, canonicalUrl).href
---

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="preconnect" href="https://ka-f.fontawesome.com" crossorigin />
  <meta name="theme-color" content="#4c3170" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="Queer Omaha" />
  <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
  <link
    rel="alternate"
    type="text/calendar"
    href="/events.ics"
    title="Queer Omaha Events"
  />
  {description && <meta name="description" content={description} />}
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Queer Omaha" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:image" content={imageUrl} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={imageAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  {description && <meta name="twitter:description" content={description} />}
  <meta name="twitter:image" content={imageUrl} />
  <meta name="twitter:image:alt" content={imageAlt} />
  <!-- Preload the two critical (body + display) font subsets so the browser
       discovers them before the (hashed) bundle CSS arrives.
       See https://web.dev/articles/codelab-preload-web-fonts -->
  <link
    rel="preload"
    as="font"
    type="font/woff2"
    href={karlaNormalUrl}
    crossorigin
  />
  <link
    rel="preload"
    as="font"
    type="font/woff2"
    href={spaceGroteskNormalUrl}
    crossorigin
  />
  <script is:inline>
    {
      const mql = window.matchMedia("(prefers-color-scheme: dark)");
      const apply = () => {
        document.documentElement.classList.toggle("wa-dark", mql.matches);
      };
      apply();
      mql.addEventListener("change", apply);
    }
  </script>
  {
    refresh && (
      <meta
        http-equiv="refresh"
        content={`${refresh.seconds};url=${refresh.url}`}
      />
    )
  }
  <LD
    data={{
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "Queer Omaha",
      url: Astro.site?.href ?? canonicalUrl,
      description:
        "Community-maintained directory of queer groups, spaces, and resources in Omaha, Nebraska.",
      creator: {
        "@type": "Person",
        name: "Tara X Void",
        gender: "https://en.pronouns.page/are/xe%26she",
        description: "Initial Creator of queeromaha.net",
        sameAs: "https://github.com/taraxvoid",
      },
    }}
  />
  <script>
    if ("serviceWorker" in navigator) {
      navigator.serviceWorker.register("/sw.js");
    }
  </script>
  <PostHog />
</head>
