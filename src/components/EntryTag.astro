---
import { Icon } from 'astro-icon/components'

interface Props {
    label: string
    icon: string
}
const { label, icon } = Astro.props
const id = `et-${crypto.randomUUID()}`
---

<span {id} class="et" title={label} role="img" aria-label={label} tabindex="0">
    <Icon name={icon} width="1.25em" height="1.25em" aria-hidden="true" />
</span>
<wa-tooltip for={id} aria-hidden="true">{label}</wa-tooltip>
<script>
    await Promise.all([
        import("@awesome.me/webawesome/dist/components/tooltip/tooltip.js"),
        customElements.whenDefined("wa-tooltip"),
    ]);
    const entryTags = document.querySelectorAll<HTMLSpanElement>(".et");
    for (const et of entryTags) {
        et.removeAttribute("title");
    }
</script>
<style>
    .et {
        margin-left: 0.35rem;
        font-size: 1rem;
        color: #7c3aed;
        vertical-align: text-bottom;
        position: relative;
        top: -0.15em;
        @media (prefers-color-scheme: dark) {
            color: var(--dm-glow);
        }
    }

    .et:focus-visible {
        outline: 2px solid currentColor;
        outline-offset: 2px;
        border-radius: 4px;
    }

    /* Hides wa-tooltip until web awesome script loads */
    wa-tooltip:not(:defined) {
        display: none;
    }
</style>
