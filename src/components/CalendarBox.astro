---
import { Icon } from 'astro-icon/components'
---

<details class="calendar-box" id="calendarBox" name="footer-accordion">
  <summary class="footer-pill-btn">
    <Icon
      name="fa7-regular:calendar"
      width="1.25em"
      height="1.25em"
      aria-hidden="true"
    />
    <span class="footer-cal-label">Gay Agenda</span>
  </summary>
  <div class="calendar-box-panel-wrap">
    <div class="calendar-preview">
      <span class="calendar-preview-label">(Preview) Upcoming Events</span>
      <div class="calendar-preview-list">
        <div class="calendar-preview-row">
          <span class="calendar-preview-row-time"></span>
          <span class="calendar-preview-row-title"></span>
        </div>
        <div class="calendar-preview-row">
          <span class="calendar-preview-row-time"></span>
          <span class="calendar-preview-row-title"></span>
        </div>
        <div class="calendar-preview-row">
          <span class="calendar-preview-row-time"></span>
          <span class="calendar-preview-row-title"></span>
        </div>
      </div>
      <p class="calendar-preview-empty" hidden>No events to preview</p>
    </div>
    <div class="calendar-toggle-row">
      <a
        class="calendar-option"
        href="https://calendar.google.com/calendar/r?cid=webcal%3A%2F%2Fqueeromaha.net%2Fevents.ics"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Subscribe to the Queer Omaha Events calendar in Google Calendar"
      >
        <Icon
          name="fa7-brands:google-plus-g"
          width="1.25em"
          height="1.25em"
          aria-hidden="true"
        />Google Cal
      </a>
      <a
        class="calendar-option"
        href="webcal://queeromaha.net/events.ics"
        aria-label="Add to Calendar (Apple Calendar and other calendar apps)"
      >
        <Icon
          name="fa7-solid:apple-whole"
          width="1.25em"
          height="1.25em"
          aria-hidden="true"
        />Apple Cal
      </a>
    </div>
  </div>
</details>

<script>
  import "../scripts/calendarBox";
  import "../scripts/calendarPreview";
</script>
<script is:inline>
  document.addEventListener("click", function (e) {
    const anchor = e.target.closest(".calendar-option");
    if (!anchor) return;
    const provider = anchor.href.includes("google") ? "google" : "apple";
    window.posthog?.capture("calendar_subscribed", {
      calendar_provider: provider,
    });
  });
</script>
