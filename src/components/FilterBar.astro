---
import { Icon } from 'astro-icon/components'
import tagMap from '#data/tagMap.json'

const tags = Object.entries(
    tagMap as Record<string, { icon: string; label: string }>,
).map(([slug, { icon, label }]) => ({ slug, icon, label }))
---

<div class="filter-bar">
  <div
    class="filter-pills filter-pills--tags"
    role="group"
    aria-label="Filter by tag"
  >
    {
      tags
        .filter(({ slug }) => slug !== "online")
        .map(({ slug, icon, label }) => (
          <button
            class="filter-pill"
            type="button"
            data-filter={slug}
            data-filter-type="tag"
            aria-pressed="false"
          >
            <Icon
              width="1.25em"
              height="1.25em"
              name={icon}
              aria-hidden="true"
            />
            {label}
          </button>
        ))
    }
    {
      tags.some(({ slug }) => slug === "online") && (
        <span class="filter-pill-divider" aria-hidden="true" />
      )
    }
    {
      tags
        .filter(({ slug }) => slug === "online")
        .map(({ slug, icon, label }) => (
          <button
            class="filter-pill"
            type="button"
            data-filter={slug}
            data-filter-type="tag"
            aria-pressed="false"
          >
            <Icon
              name={icon}
              width="1.25em"
              height="1.25em"
              aria-hidden="true"
            />
            {label}
          </button>
        ))
    }
  </div>
</div>
<style>
  .filter-bar {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.4rem;
    margin-top: -0.75rem;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 3px solid #7c3aed;
    box-shadow: 0 6px 10px -4px rgba(124, 58, 237, 0.13);
    @media (prefers-color-scheme: dark) {
      border-bottom-color: var(--dm-glow);
      box-shadow: 0 6px 10px -4px rgba(0, 0, 0, 0.35);
    }
  }

  .filter-pills {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    &.filter-pills--tags {
      padding-top: 0.5rem;
      margin-top: 0.15rem;
      border-top: 1px solid #ddd6fe;
      width: 100%;
      @media (prefers-color-scheme: dark) {
        border-top-color: rgba(196, 181, 253, 0.25);
      }
    }
    @media (max-width: 480px) {
      flex-wrap: nowrap;
      overflow-x: auto;
      padding-bottom: 4px;
      scrollbar-width: none;
      &::-webkit-scrollbar {
        display: none;
      }
    }
  }

  .filter-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    background: #f9f5ff;
    border: 1px solid #ddd6fe;
    color: #6d28d9;
    font-size: 0.78rem;
    font-weight: 700;
    font-family: var(--font-mono);
    cursor: pointer;
    white-space: nowrap;
    box-shadow: 0 2px 0 #ddd6fe;
    @media (prefers-reduced-motion: no-preference) {
      transition:
        background 0.15s,
        border-color 0.15s,
        color 0.15s,
        box-shadow 0.15s,
        transform 0.15s;
    }
    &:hover,
    &:focus {
      background: #ede9fe;
      border-color: #a78bfa;
    }
    &:active {
      box-shadow: inset 0 1px 3px rgba(76, 29, 118, 0.25);
      transform: translateY(1px);
    }
    &[aria-pressed="true"] {
      background: #ede9fe;
      border-color: #a78bfa;
      color: #5b21b6;
      box-shadow: inset 0 1px 3px rgba(76, 29, 118, 0.25);
      transform: translateY(1px);
      &:hover,
      &:focus {
        background: #ddd6fe;
        border-color: #7c3aed;
      }
    }
    &:disabled {
      opacity: 0.35;
      cursor: not-allowed;
    }
    @media (prefers-color-scheme: dark) {
      background: var(--dm-dusk);
      border-color: rgba(196, 181, 253, 0.3);
      color: var(--dm-glow);
      box-shadow: 0 2px 0 rgba(196, 181, 253, 0.25);
      &:hover,
      &:focus {
        background: rgba(196, 181, 253, 0.12);
        border-color: #a78bfa;
      }
      &:active {
        box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.5);
      }
      &[aria-pressed="true"] {
        background: rgba(196, 181, 253, 0.15);
        border-color: #a78bfa;
        color: var(--dm-moonlight);
        box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.5);
        &:hover,
        &:focus {
          background: rgba(196, 181, 253, 0.22);
          border-color: var(--dm-glow);
        }
      }
    }
  }

  .filter-pill-divider {
    align-self: stretch;
    width: 1px;
    margin: 0.2rem 0.15rem;
    background: #c4b5fd;
    box-shadow: 1px 0 0 rgba(124, 58, 237, 0.15);
    flex: 0 0 auto;
    @media (prefers-color-scheme: dark) {
      background: rgba(196, 181, 253, 0.4);
      box-shadow: none;
    }
  }
</style>
