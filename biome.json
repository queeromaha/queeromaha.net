{
    "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
    "extends": ["@taraxvoid/voidflow/biome"],
    "formatter": {
        "includes": [
            "**",
            "!**/bun.lock",
            "!**/deno.lock",
            "!**/.husky/",
            "!public/admin/**"
        ]
    },
    "linter": {
        "includes": ["**", "!.astro/**", "!public/admin/**", "!public/**/*.svg"]
    }
}
