{
    "name": "queeromaha.com",
    "type": "module",
    "version": "1.0.3",
    "description": "queer stuff in omaha",
    "scripts": {
        "test": "npm-run-all -l -s build -p check test:unit -s test:e2e:full",
        "test:push": "npm-run-all -l -s build -p check test:unit -s test:e2e:smoke",
        "test:unit": "vitest run",
        "test:unit:precommit": "bun run test:unit -- --exclude 'test/build.test.ts' --exclude 'test/structured-data.test.ts'",
        "test:fast": "run-p -l lint test:data",
        "test:data": "vitest run test/data.test.ts",
        "test:ical": "vitest run test/ical.test.ts",
        "test:build": "vitest run test/build.test.ts",
        "test:structured-data": "vitest run test/structured-data.test.ts",
        "test:e2e": "bun run build && playwright test --project=mobile-chrome",
        "test:e2e:full": "playwright test --project=mobile-chrome",
        "test:e2e:a11y": "bun run build && playwright test test/e2e/a11y.spec.js --project=mobile-chrome",
        "test:e2e:smoke": "playwright test --project=mobile-chrome site.spec",
        "test:e2e:desktop": "bun run build && playwright test --project=desktop-chrome",
        "test:e2e:all": "bun run build && playwright test",
        "test:e2e:ui": "bun run build && playwright test --ui",
        "test:e2e:headed": "bun run build && playwright test --headed",
        "test:e2e:lighthouse": "bun run build && unlighthouse-runner --dir dist",
        "dev": "astro dev",
        "audit": "bun audit --audit-level high --production",
        "start": "astro dev",
        "stop": "astro dev stop",
        "check": "astro check",
        "check:content": "astro sync",
        "check:licenses": "check-licenses",
        "check:links": "bun scripts/check-links.ts",
        "serve": "astro dev",
        "build": "astro build && bun scripts/generate-redirects.ts && cp dist/sitemap-index.xml dist/sitemap.xml",
        "preview": "astro preview",
        "prepare": "lefthook install || echo 'lefthook not installed (run mise install); git hooks skipped'",
        "lint": "biome check .",
        "lint:migrate": "biome migrate --write",
        "lint:actions": "./scripts/lint-actions.sh",
        "format": "biome check --write . && bun scripts/format-yaml.ts",
        "generate:favicons": "bun run scripts/generate-favicons.ts",
        "commit": "bunx opencommit",
        "changelog": "git-cliff -o CHANGELOG.md",
        "changelog:unreleased": "git-cliff --unreleased",
        "generate:og-image": "bun scripts/generate-og-image.ts"
    },
    "imports": {
        "#components/*": "./src/components/*",
        "#data/*": "./src/data/*",
        "#layouts/*": "./src/layouts/*",
        "#styles/*": "./src/styles/*",
        "#utils/*": "./src/utils/*"
    },
    "keywords": [],
    "author": "Tara <1711810+taraxvoid@users.noreply.github.com>",
    "license": "MIT",
    "engines": {
        "bun": ">=1.4.0"
    },
    "dependencies": {
        "@astrojs/sitemap": "^3.7.4",
        "@awesome.me/webawesome": "^3.12.0",
        "@fontsource-variable/karla": "^5.3.0",
        "@fontsource-variable/space-grotesk": "^5.3.0",
        "@fontsource/space-mono": "^5.3.0",
        "@iconify-json/fa7-brands": "^1.2.4",
        "@iconify-json/fa7-regular": "^1.2.3",
        "@iconify-json/fa7-solid": "^1.2.5",
        "astro": "^7.3.1",
        "astro-icon": "^1.2.0",
        "posthog-js": "^1.427.2",
        "rrule": "^2.8.1",
        "schema-dts": "^2.0.0"
    },
    "devDependencies": {
        "@astrojs/check": "0.9.12",
        "@axe-core/playwright": "^4.13.0",
        "@biomejs/biome": "^2.5.12",
        "@fontsource/karla": "^5.3.0",
        "@fontsource/space-grotesk": "^5.3.0",
        "@lizenz/checker": "^0.0.2",
        "@netlify/edge-functions": "^3.0.8",
        "@playwright/test": "^1.63.0",
        "@posthog/cli": "^0.18.0",
        "@socketsecurity/bun-security-scanner": "^1.1.2",
        "@taraxvoid/voidflow": "^0.16.0",
        "@types/bun": "^1.4.1",
        "@types/semver": "^7.8.0",
        "favicons": "^7.3.1",
        "happy-dom": "^21.0.4",
        "npm-run-all2": "^9.0.3",
        "satori": "^0.46.0",
        "semver": "^7.8.5",
        "sharp": "^0.35.5",
        "typescript": "^6.0.3",
        "vitest": "^4.1.11",
        "yaml": "^2.9.0"
    },
    "overrides": {
        "shell-quote": "^1.11.0",
        "basic-ftp": "6.2.3"
    }
}
